{
  "name": "@guibonin/sakura-ui",
  "version": "0.1.0",
  "description": "Biblioteca de componentes React modernos, acessíveis e com temas claro e escuro.",
  "license": "MIT",
  "author": "Guilherme Bonin",
  "homepage": "https://guibonin.github.io/sakura-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuiBonin/sakura-ui.git",
    "directory": "packages/sakura-ui"
  },
  "bugs": {
    "url": "https://github.com/GuiBonin/sakura-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "acessibilidade",
    "typescript",
    "sakura"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.79.0"
  }
}
